{
  "version": 2,
  "source": "DomNexDomain Community Signatures",
  "rules": [
    {
      "id": "wp-core",
      "signal": "signature.wp_scanner",
      "family": "wp_scanner",
      "pathContains": [
        "/wp-admin",
        "/wp-login",
        "/wp-content",
        "/wp-includes",
        "xmlrpc.php",
        "wlwmanifest.xml",
        "wp-trackback"
      ]
    },
    {
      "id": "secret-leaks",
      "signal": "signature.secret_hunter",
      "family": "secret_hunter",
      "pathContains": [
        "/.env",
        "/.git/config",
        "/config.env",
        "/api/.env",
        "/laravel/.env",
        "/docker/.env"
      ]
    },
    {
      "id": "webshell-probe",
      "signal": "signature.webshell_probe",
      "family": "webshell_probe",
      "pathContains": [
        "ioxi-o.php",
        "/file.php",
        "/rip.php",
        "/sf.php",
        "/wso.php",
        "/r57.php",
        "/shell.php",
        "/cmd.php",
        "/xmr.php",
        "/xmrlpc.php",
        "/zwso.php"
      ]
    },
    {
      "id": "flat-php-probe",
      "signal": "signature.flat_php_probe",
      "family": "flat_php_probe",
      "pathContains": [
        "/inputs.php",
        "/adminfuns.php",
        "/class-t.api.php",
        "/ms-edit.php",
        "/randkeyword.php",
        "/randkeyword.php7",
        "/kbfr.php"
      ]
    },
    {
      "id": "hidden-index-dropper",
      "signal": "signature.hidden_index_dropper",
      "family": "hidden_index_dropper",
      "pathContains": [
        "/wk/index.php",
        "/.well-known/logs233/index.php",
        "/.trash7206/index.php",
        "/update/da222.php"
      ]
    },
    {
      "id": "admin-surface",
      "signal": "signature.admin_surface_probe",
      "family": "admin_surface_probe",
      "pathContains": [
        "/admin.php",
        "/admin/",
        "/manager/html",
        "/hudson",
        "/jenkins",
        "/server-status",
        "/actuator/env"
      ]
    },
    {
      "id": "api-enum",
      "signal": "signature.api_enum",
      "family": "api_enum",
      "pathPrefix": [
        "/api/"
      ],
      "pathContains": [
        "/api/settings",
        "/api/config",
        "/graphql"
      ]
    },
    {
      "id": "scanner-ua",
      "signal": "signature.scanner_ua",
      "family": "scanner_ua",
      "uaContains": [
        "zgrab",
        "masscan",
        "nmap",
        "sqlmap",
        "nikto",
        "nuclei",
        "dirbuster",
        "gobuster",
        "wpscan"
      ]
    }
  ]
}
